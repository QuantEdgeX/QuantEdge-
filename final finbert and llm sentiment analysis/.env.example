# Copy to .env (already in .gitignore) and fill in. Never commit real keys.

# --- Required for LLM_PROVIDER=gemini -------------------------------------
GEMINI_API_KEY=your-key-here          # GOOGLE_API_KEY is also accepted

# --- Hugging Face (financial-news-multisource is GATED, research/education use only) ---
# Accept the terms on the dataset page, then create a read token.
HF_TOKEN=hf_your-read-token

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=gemini                   # gemini | mock (mock = offline keyword stub for testing)
GEMINI_MODEL=gemini-3.8-flash        # check Google's current model list/pricing before a big run
PROMPT_VERSION=v1                     # bump when you edit src/sentiment/prompts.py
LLM_BATCH_SIZE=5                      # articles per request
LLM_REQUESTS_PER_MINUTE=60            # set to your plan's limit; 0 disables client-side limiting
LLM_MAX_WORKERS=1                     # concurrent requests (keep RPM in mind)
LLM_MAX_RETRIES=6
MAX_ARTICLE_CHARS=3000
INCLUDE_DATE_IN_PROMPT=false          # false hides dates from the model (less hindsight recall)
# GEMINI_THINKING_BUDGET=0            # optional, Gemini 2.5 models only

# --- Pipeline -------------------------------------------------------------
PREDICTION_CUTOFF_ET=16:00            # articles after this (New York time) count for the NEXT trading day
MIN_RELEVANCE=0.30
REQUIRE_TEXT_EVIDENCE=true
# News window: leave unset to use the six-year window chosen by `select-period`.
# NEWS_START=2018-01-01
# NEWS_END=2023-12-31
PERIOD_YEARS=6
SENTIMENT_DATA_DIR=src/data/sentiment
STOCK_DATA_PATH=src/data/stock_data.csv
LOG_LEVEL=INFO
